# YApi 版本（项目已长期停止维护，latest 即最终版 1.10.2）：
YAPI_VERSION=latest            # 默认
# YAPI_VERSION=1.10.2

# MongoDB 版本（yapi 内置 mongoose 对 mongo 7+ 兼容性差，建议固定 6.0）：
MONGO_VERSION=6.0              # 默认
# MONGO_VERSION=4.4

YAPI_PORT=40001

MONGO_PORT=27017
DB_DATABASE=yapi

YAPI_ADMIN_ACCOUNT=admin@yapi.com
YAPI_ADMIN_PASSWORD=admin