# Tailscale Auth Key (从 https://login.tailscale.com/admin/settings/keys 生成)
# 建议勾选 Reusable
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxx

# 节点主机名 (显示在 Tailscale Admin Console)
TS_HOSTNAME=my-tailscale-router

# 广播的子网路由 (逗号分隔, 需在 Admin Console 批准)
# 示例: 192.168.1.0/24
# 示例: 10.10.30.0/24,10.10.10.0/24
TS_ROUTES=192.168.1.0/24

# MTU (默认 1420, WireGuard 标准值)
TS_MTU=1420

# 额外参数 (可选)
# 广播为出口节点: TS_EXTRA_ARGS=--advertise-exit-node
# 接受 DNS:       TS_EXTRA_ARGS=--accept-dns
TS_EXTRA_ARGS=
