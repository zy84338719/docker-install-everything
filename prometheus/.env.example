# Prometheus 版本（v3 为当前主推，配置语法与 v2 基本兼容）：
PROMETHEUS_VERSION=v3.13.2     # 默认
# PROMETHEUS_VERSION=v2.55.1   # v2 末代稳定

# Grafana 版本：
GRAFANA_VERSION=13.1.3         # 默认
# GRAFANA_VERSION=11.2.0

# Pushgateway 版本：
PUSHGATEWAY_VERSION=v1.11.3    # 默认

# Alertmanager 版本：
ALERTMANAGER_VERSION=v0.33.1   # 默认
