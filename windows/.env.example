# Windows Docker image version
WINDOWS_VERSION=latest

# Windows version to install: win11, win10, ltsc10, win8, win7, vista, winxp
# Server versions: 2025, 2022, 2019, 2016, 2012, 2008
# Or a custom ISO URL
VERSION=win11

# Disk size (default: 64G)
DISK_SIZE=256G

# RAM size (default: 4G)
RAM_SIZE=8G

# CPU cores (default: 2)
CPU_CORES=4

# Windows login credentials
USERNAME=Windows
PASSWORD=Windows

# Language (default: English)
LANGUAGE=Chinese
