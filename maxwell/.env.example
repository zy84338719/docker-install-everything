# Maxwell 版本：
MAXWELL_VERSION=v1.44.0
# MAXWELL_VERSION=latest

# MySQL 版本（maxwell 需 ROW 格式 binlog，compose 已配置）：
MYSQL_VERSION=8.4              # 默认：8.4 LTS
# MYSQL_VERSION=8.0
# MYSQL_VERSION=5.7

# Redis 版本（完整 tag）：
REDIS_VERSION=8.0-alpine       # 默认
# REDIS_VERSION=7.4-alpine
# REDIS_VERSION=6.2-alpine

MYSQL_DATABASE=maxwell
MYSQL_USER=maxwell
MYSQL_PASSWORD=123456
MYSQL_ROOT_PASSWORD=123456