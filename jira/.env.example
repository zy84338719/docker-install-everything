### jira #################################################
WEB_PORT=8081
ATL_PROXY_NAME=jira.example.com
# Jira 版本（官方仅发布 latest 滚动 tag，留空=latest）：
JIRA_VERSION=latest

### mysql #################################################
# MySQL 版本，可选（取消注释其一）：
MYSQL_VERSION=8.4              # 默认：8.4 LTS
# MYSQL_VERSION=8.0            # 8.0（EOL 2026-04）
# MYSQL_VERSION=5.7            # 5.7（已 EOL，不推荐）

DB_HOST=jira-mysql
DB_PORT=3306
DB_DATABASE=jiradb
DB_USER=jira_user
DB_PASSWORD=jira_pswd
DB_NAME=jiradb
ROOT_PASSWORD=123456
MYSQL_TIMEZONE=Asia/Shanghai

DOCKER_SUBNET=10.10.11.0/16