# WordPress 版本（latest 滚动 tag；也可固定如 6.6）：
WORDPRESS_VERSION=latest
# WORDPRESS_VERSION=6.6

# MySQL 版本，可选（取消注释其一）：
MYSQL_VERSION=8.4              # 默认：8.4 LTS
# MYSQL_VERSION=8.0            # 8.0（EOL 2026-04）
# MYSQL_VERSION=5.7            # 5.7（已 EOL，不推荐）

# 数据库root账号密码
DB_ROOT_PASSWORD=root
# 数据库名称
DB_NAME=wordpress
# 数据库 用户名
DB_USER=wordpress
# 数据库 密码
DB_PASSWORD=wordpress
# 数据库 HOST名称
HOST_MYSQL=wordpress_mysql