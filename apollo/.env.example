
# Apollo 版本（三个组件共用同一版本）：
APOLLO_VERSION=v2.5.2
# APOLLO_VERSION=v2.2.0

# MySQL 版本，可选（取消注释其一）：
MYSQL_VERSION=8.4              # 默认：8.4 LTS
# MYSQL_VERSION=8.0            # 8.0（EOL 2026-04）
# MYSQL_VERSION=5.7            # 5.7（已 EOL，不推荐）

MYSQL_DATABASE=ApolloConfigDB
MYSQL_USER=apollo
MYSQL_PASSWORD=123456
MYSQL_ROOT_PASSWORD=123456