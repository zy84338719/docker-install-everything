# ELK_VERSION=8.17.0           # 8.x 末代稳定
# ELK_VERSION=7.17.28          # 7.x 末代（老配置兼容）

# Confluent Kafka / ZooKeeper 版本（同属 cp 系列，建议一致）：
KAFKA_VERSION=7.8.0           # 默认
# KAFKA_VERSION=7.7.0

SUBNET=172.28.0.1/16
FILEBEAT_IP=172.28.0.2
ZK_IP=172.28.0.3
KAFKA_IP=172.28.0.4
LOGSTASH_IP=172.28.0.5
