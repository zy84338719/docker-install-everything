############### MongoDB ###############
# MongoDB 版本：
MONGO_VERSION=8.0              # 默认
# MONGO_VERSION=7.0
# MONGO_VERSION=6.0

MONGO_PORT=27017
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=123456

############### Mongo Express ###############
# Mongo Express 版本（官方镜像已标 DEPRECATED）：
MONGO_EXPRESS_VERSION=1.0.2    # 默认
# MONGO_EXPRESS_VERSION=1-20

MONGO_EXPRESS_PORT=8081
ME_CONFIG_BASICAUTH_USERNAME=dev
ME_CONFIG_BASICAUTH_PASSWORD=dev